{
  "entities": {
    "Brand": {
      "title": "Brand",
      "description": "An automobile manufacturer.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "country": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "lastUpdated": { "type": "object" }
      },
      "required": ["name"]
    },
    "Model": {
      "title": "Model",
      "description": "A specific car model.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "brandId": { "type": "string" }
      },
      "required": ["name", "brandId"]
    },
    "Powertrain": {
      "title": "Powertrain",
      "description": "Engine and transmission configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "modelId": { "type": "string" },
        "engine": { "type": "string" },
        "fuelType": { "type": "string" },
        "transmission": { "type": "string" }
      },
      "required": ["name", "modelId"]
    },
    "ServiceInterval": {
      "title": "Service Interval",
      "description": "A specific maintenance schedule interval.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "powertrainId": { "type": "string" },
        "months": { "type": "number" },
        "kilometers": { "type": "number" },
        "laborCost": { "type": "number" },
        "partsCost": { "type": "number" },
        "totalCost": { "type": "number" }
      }
    },
    "ImportLog": {
      "title": "Import Log",
      "description": "Record of a JSON data import operation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "timestamp": { "type": "object" },
        "fileName": { "type": "string" },
        "mode": { "type": "string" },
        "results": {
          "type": "object",
          "properties": {
            "brands": { "type": "number" },
            "models": { "type": "number" },
            "powertrains": { "type": "number" },
            "intervals": { "type": "number" }
          }
        },
        "errorCount": { "type": "number" }
      },
      "required": ["userId", "timestamp", "fileName"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "object" },
        "lastLogin": { "type": "object" }
      },
      "required": ["uid", "email"]
    },
    "AccessRequest": {
      "title": "Access Request",
      "description": "User request for administrator access.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "message": { "type": "string" }
      },
      "required": ["userId", "userEmail", "status"]
    },
    "EvRange": {
      "title": "EV Range",
      "description": "Scraped EV model range and efficiency parameters.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "battery_kwh": { "type": "number" },
        "claimed_range_km": { "type": "number" },
        "real_range_km": { "type": "number" },
        "scrapedAt": { "type": "string" }
      },
      "required": ["brand", "model"]
    },
    "Admin": {
      "title": "Admin",
      "description": "User with administrator access level",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "grantedAt": { "type": "object" },
        "grantedBy": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Article": {
      "title": "Article",
      "description": "Search-optimized vehicle report or EV range article.",
      "type": "object",
      "properties": {
        "brandId": { "type": "string" },
        "brandName": { "type": "string" },
        "modelId": { "type": "string" },
        "modelName": { "type": "string" },
        "content": { "type": "string" },
        "articleType": { "type": "string" },
        "updatedAt": { "type": "object" }
      },
      "required": ["content", "updatedAt"]
    }
  },
  "firestore": {
    "/brands": { "schema": "Brand", "description": "Collection of automobile brands" },
    "/models": { "schema": "Model", "description": "Collection of car models" },
    "/powertrains": { "schema": "Powertrain", "description": "Collection of powertrain options" },
    "/serviceIntervals": { "schema": "ServiceInterval", "description": "Collection of maintenance intervals" },
    "/importLogs": { "schema": "ImportLog", "description": "Log of data import operations" },
    "/users": { "schema": "User", "description": "User profiles" },
    "/accessRequests": { "schema": "AccessRequest", "description": "Requests for admin access" },
    "/evRangeData": { "schema": "EvRange", "description": "Google Sheets live synchronized EV models range database" },
    "/admins": { "schema": "Admin", "description": "Privileged administrator profiles" },
    "/articles": { "schema": "Article", "description": "Collection of compiled vehicle articles and range reports" }
  }
}
